# Shipped files and the shared sources copied into packs stay LF in every checkout (F67, tools/check-eol.mjs).
packs/**/*.js text eol=lf
packs/**/*.json text eol=lf
packs/**/*.lang text eol=lf
packs/**/*.mcfunction text eol=lf
packs/**/*.material text eol=lf
packs/**/*.txt text eol=lf
tools/*-shared.js text eol=lf
# The docs (published as the players' docs, read by help-catalog.mjs) and the workflows stay LF too.
docs/**/*.md text eol=lf
.github/** text eol=lf
