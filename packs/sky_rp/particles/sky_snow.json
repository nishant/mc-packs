{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "realm:sky_snow",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particle/realm_sky_streak"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 20
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0
      },
      "minecraft:emitter_shape_box": {
        "half_dimensions": [
          4,
          2,
          4
        ]
      },
      "minecraft:particle_initial_speed": 0,
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "Math.random(0.9, 1.6)"
      },
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          "variable.wx * 4 + Math.sin(variable.particle_age * 260 + variable.particle_random_1 * 360) * 3",
          "-10 + Math.sin(variable.particle_age * 200 + variable.particle_random_2 * 360) * 2",
          "variable.wz * 4 + Math.cos(variable.particle_age * 240 + variable.particle_random_3 * 360) * 3"
        ],
        "linear_drag_coefficient": 4
      },
      "minecraft:particle_motion_collision": {
        "collision_radius": 0.05,
        "expire_on_contact": true
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.22 + variable.particle_random_1 * 0.12",
          0.035
        ],
        "facing_camera_mode": "lookat_direction",
        "uv": {
          "texture_width": 32,
          "texture_height": 8,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            32,
            8
          ]
        }
      },
      "minecraft:particle_appearance_lighting": {},
      "minecraft:particle_appearance_tinting": {
        "color": [
          0.95,
          0.97,
          1,
          "Math.clamp(Math.min(variable.particle_age / 0.1, (variable.particle_lifetime - variable.particle_age) / 0.3), 0, 1) * 0.85"
        ]
      }
    }
  }
}
