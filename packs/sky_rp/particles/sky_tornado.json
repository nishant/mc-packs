{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "realm:sky_tornado",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particle/realm_sky_dust"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": "Math.clamp((variable.radius > 0 ? variable.radius : 2) * 8 + 16, 24, 68)"
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0
      },
      "minecraft:emitter_shape_point": {},
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "Math.random(0.85, 1.35)"
      },
      "minecraft:particle_motion_parametric": {
        "relative_position": [
          "Math.cos(variable.particle_random_1 * 360 + variable.particle_age * (variable.spin > 0 ? variable.spin : 5) * 57.2958 * (variable.particle_random_2 < 0.42 ? 1.2 : 0.92)) * (variable.radius > 0 ? variable.radius : 2) * (variable.particle_random_2 < 0.42 ? (0.28 + 0.52 * variable.particle_random_2) : (0.78 + 0.36 * variable.particle_random_2))",
          "variable.particle_age * (1.2 + variable.particle_random_3 * 1.5) + (variable.particle_random_2 - 0.5) * 1.1",
          "Math.sin(variable.particle_random_1 * 360 + variable.particle_age * (variable.spin > 0 ? variable.spin : 5) * 57.2958 * (variable.particle_random_2 < 0.42 ? 1.2 : 0.92)) * (variable.radius > 0 ? variable.radius : 2) * (variable.particle_random_2 < 0.42 ? (0.28 + 0.52 * variable.particle_random_2) : (0.78 + 0.36 * variable.particle_random_2))"
        ]
      },
      "minecraft:particle_initial_spin": {
        "rotation": "Math.random(0, 360)",
        "rotation_rate": "Math.random(-180, 180)"
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(0.72 + (variable.radius > 0 ? variable.radius : 2) * 0.28 + variable.particle_random_3 * 0.45) * (1 + 0.35 * (variable.particle_age / variable.particle_lifetime))",
          "(0.54 + (variable.radius > 0 ? variable.radius : 2) * 0.19 + variable.particle_random_3 * 0.32) * (1 + 0.28 * (variable.particle_age / variable.particle_lifetime))"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 128,
          "texture_height": 32,
          "uv": [
            "Math.floor(variable.particle_random_4 * 4) * 32",
            0
          ],
          "uv_size": [
            32,
            32
          ]
        }
      },
      "minecraft:particle_appearance_lighting": {},
      "minecraft:particle_appearance_tinting": {
        "color": [
          "variable.particle_random_2 < 0.42 ? (0.24 + 0.08 * variable.particle_random_3) : (0.48 + 0.16 * variable.particle_random_3 - 0.08 * variable.height)",
          "variable.particle_random_2 < 0.42 ? (0.26 + 0.08 * variable.particle_random_3) : (0.51 + 0.16 * variable.particle_random_3 - 0.07 * variable.height)",
          "variable.particle_random_2 < 0.42 ? (0.30 + 0.09 * variable.particle_random_3) : (0.56 + 0.17 * variable.particle_random_3 - 0.05 * variable.height)",
          "Math.clamp(Math.min(variable.particle_age / 0.16, (variable.particle_lifetime - variable.particle_age) / 0.36), 0, 1) * (variable.particle_random_2 < 0.42 ? 0.92 : 0.78)"
        ]
      }
    }
  }
}
