{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "realm:sky_tornado",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particle/realm_sky_dust"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": "Math.clamp((variable.radius > 0 ? variable.radius : 2) * 1.8 + 6, 8, 18)"
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0
      },
      "minecraft:emitter_shape_point": {},
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "Math.random(1.15, 1.6)"
      },
      "minecraft:particle_motion_parametric": {
        "relative_position": [
          "Math.cos(variable.particle_random_1 * 360 + variable.particle_age * (variable.spin > 0 ? variable.spin : 5) * 57.2958) * (variable.radius > 0 ? variable.radius : 2) * (0.38 + 0.68 * variable.particle_random_2)",
          "variable.particle_age * (1.1 + variable.particle_random_3 * 1.3) + (variable.particle_random_2 - 0.5) * 1.1",
          "Math.sin(variable.particle_random_1 * 360 + variable.particle_age * (variable.spin > 0 ? variable.spin : 5) * 57.2958) * (variable.radius > 0 ? variable.radius : 2) * (0.38 + 0.68 * variable.particle_random_2)"
        ]
      },
      "minecraft:particle_initial_spin": {
        "rotation": "Math.random(0, 360)",
        "rotation_rate": "Math.random(-160, 160)"
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(0.68 + (variable.radius > 0 ? variable.radius : 2) * 0.24 + variable.particle_random_3 * 0.38) * (1 + 0.3 * (variable.particle_age / variable.particle_lifetime))",
          "(0.52 + (variable.radius > 0 ? variable.radius : 2) * 0.17 + variable.particle_random_3 * 0.28) * (1 + 0.24 * (variable.particle_age / variable.particle_lifetime))"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 128,
          "texture_height": 32,
          "uv": [
            "Math.floor(variable.particle_random_4 * 4) * 32",
            0
          ],
          "uv_size": [
            32,
            32
          ]
        }
      },
      "minecraft:particle_appearance_lighting": {},
      "minecraft:particle_appearance_tinting": {
        "color": [
          "0.24 + 0.34 * variable.particle_random_2 - 0.06 * variable.height",
          "0.26 + 0.36 * variable.particle_random_2 - 0.05 * variable.height",
          "0.30 + 0.38 * variable.particle_random_2 - 0.04 * variable.height",
          "Math.clamp(Math.min(variable.particle_age / 0.18, (variable.particle_lifetime - variable.particle_age) / 0.4), 0, 1) * 0.82"
        ]
      }
    }
  }
}
