{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "realm:sky_tornado",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particle/realm_sky_dust"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": "Math.clamp((variable.radius > 0 ? variable.radius : 2) * 5, 8, 40)"
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0
      },
      "minecraft:emitter_shape_point": {},
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "Math.random(0.9, 1.4)"
      },
      "minecraft:particle_motion_parametric": {
        "relative_position": [
          "Math.cos(variable.particle_random_1 * 360 + variable.particle_age * (variable.spin > 0 ? variable.spin : 4) * 57.2958) * (variable.radius > 0 ? variable.radius : 2) * (0.9 + 0.2 * variable.particle_random_2)",
          "variable.particle_age * (0.6 + variable.particle_random_3 * 0.8) + (variable.particle_random_2 - 0.5) * 0.8",
          "Math.sin(variable.particle_random_1 * 360 + variable.particle_age * (variable.spin > 0 ? variable.spin : 4) * 57.2958) * (variable.radius > 0 ? variable.radius : 2) * (0.9 + 0.2 * variable.particle_random_2)"
        ]
      },
      "minecraft:particle_initial_spin": {
        "rotation": "Math.random(0, 360)",
        "rotation_rate": "Math.random(-120, 120)"
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(0.35 + variable.particle_random_3 * 0.4) * (1 + 0.5 * (variable.particle_age / variable.particle_lifetime))",
          "(0.35 + variable.particle_random_3 * 0.4) * (1 + 0.5 * (variable.particle_age / variable.particle_lifetime))"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 64,
          "texture_height": 16,
          "uv": [
            "Math.floor(variable.particle_random_4 * 4) * 16",
            0
          ],
          "uv_size": [
            16,
            16
          ]
        }
      },
      "minecraft:particle_appearance_lighting": {},
      "minecraft:particle_appearance_tinting": {
        "color": [
          "0.45 + 0.12 * variable.particle_random_2",
          "0.42 + 0.1 * variable.particle_random_2",
          "0.38 + 0.08 * variable.particle_random_2",
          "Math.clamp(Math.min(variable.particle_age / 0.2, (variable.particle_lifetime - variable.particle_age) / 0.4), 0, 1) * 0.75"
        ]
      }
    }
  }
}
