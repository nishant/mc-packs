{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "realm:nos_ribbon",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/realm_sky_glow"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": "(variable.n > 0 ? variable.n : 12)"
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0
      },
      "minecraft:emitter_shape_point": {},
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "(variable.hot > 0 && variable.particle_random_4 < 0.45) ? Math.random(0.8, 1.3) : Math.random(0.3, 0.6)"
      },
      "minecraft:particle_motion_parametric": {
        "relative_position": [
          "variable.dx * variable.particle_random_1 + (variable.particle_random_2 - 0.5) * 0.4",
          "variable.dy * variable.particle_random_1 + (variable.particle_random_3 - 0.5) * 0.32 + ((variable.hot > 0 && variable.particle_random_4 < 0.45) ? variable.particle_age * 1.1 : 0)",
          "variable.dz * variable.particle_random_1 + (Math.mod(variable.particle_random_2 * 7, 1) - 0.5) * 0.4"
        ]
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "((variable.hot > 0 && variable.particle_random_4 < 0.45) ? 0.07 : 0.14 + variable.particle_random_3 * 0.06) * (1 - 0.6 * (variable.particle_age / variable.particle_lifetime))",
          "((variable.hot > 0 && variable.particle_random_4 < 0.45) ? 0.07 : 0.14 + variable.particle_random_3 * 0.06) * (1 - 0.6 * (variable.particle_age / variable.particle_lifetime))"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 32,
          "texture_height": 32,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            32,
            32
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "(variable.hot > 0 && variable.particle_random_4 < 0.45) ? 1 : 0.4 + 0.3 * (variable.particle_age / variable.particle_lifetime)",
          "(variable.hot > 0 && variable.particle_random_4 < 0.45) ? 0.92 - 0.6 * (variable.particle_age / variable.particle_lifetime) : 0.75",
          "(variable.hot > 0 && variable.particle_random_4 < 0.45) ? 0.5 - 0.4 * (variable.particle_age / variable.particle_lifetime) : 1",
          "1 - (variable.particle_age / variable.particle_lifetime)"
        ]
      }
    }
  }
}
