{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "realm:sky_meteor",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/realm_sky_meteor"
      }
    },
    "components": {
      "minecraft:emitter_rate_steady": {
        "spawn_rate": 70,
        "max_particles": 160
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": "(variable.life > 0 ? variable.life : 3)"
      },
      "minecraft:emitter_shape_point": {
        "offset": [
          "variable.dx * variable.emitter_age",
          "variable.dy * variable.emitter_age",
          "variable.dz * variable.emitter_age"
        ],
        "direction": [
          "Math.random(-1, 1)",
          "Math.random(-1, 1)",
          "Math.random(-1, 1)"
        ]
      },
      "minecraft:particle_initial_speed": "Math.random(0.3, 1.5)",
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "Math.random(0.9, 1.7)"
      },
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          0.6,
          0
        ],
        "linear_drag_coefficient": 1.2
      },
      "minecraft:particle_initial_spin": {
        "rotation": "Math.random(0, 360)",
        "rotation_rate": "Math.random(-90, 90)"
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(1.5 - 1.15 * Math.sqrt((variable.particle_age / variable.particle_lifetime))) * (0.85 + 0.3 * variable.particle_random_1) * (variable.size > 0 ? variable.size : 1)",
          "(1.5 - 1.15 * Math.sqrt((variable.particle_age / variable.particle_lifetime))) * (0.85 + 0.3 * variable.particle_random_1) * (variable.size > 0 ? variable.size : 1)"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 32,
          "texture_height": 32,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            32,
            32
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "(variable.particle_age / variable.particle_lifetime)",
          "gradient": {
            "0.0": [
              1,
              1,
              0.95,
              1
            ],
            "0.12": [
              1,
              0.85,
              0.45,
              0.95
            ],
            "0.4": [
              1,
              0.45,
              0.12,
              0.7
            ],
            "0.75": [
              0.55,
              0.12,
              0.05,
              0.35
            ],
            "1.0": [
              0.2,
              0.04,
              0.02,
              0
            ]
          }
        }
      }
    }
  }
