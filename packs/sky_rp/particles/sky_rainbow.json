{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "realm:sky_rainbow",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particle/realm_sky_rainbow"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 1
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0
      },
      "minecraft:emitter_shape_point": {
        "offset": [
          0,
          "(variable.size > 0 ? variable.size : 60) / 4",
          0
        ]
      },
      "minecraft:particle_initial_speed": 0,
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "(variable.life > 0 ? variable.life : 30)"
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(variable.size > 0 ? variable.size : 60) / 2",
          "(variable.size > 0 ? variable.size : 60) / 4"
        ],
        "facing_camera_mode": "rotate_y",
        "uv": {
          "texture_width": 256,
          "texture_height": 128,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            256,
            128
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          1,
          1,
          1,
          "Math.clamp(Math.min(variable.particle_age / 1, (variable.particle_lifetime - variable.particle_age) / 1), 0, 1) * 0.55"
        ]
      }
    }
  }
}
