{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "realm:nos_ring",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/realm_sky_glow"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": "variable.hot > 0 ? 24 : 14"
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0
      },
      "minecraft:emitter_shape_point": {},
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "(variable.hot > 0 && variable.particle_random_4 < 0.45) ? Math.random(0.6, 1.0) : Math.random(0.15, 0.35)"
      },
      "minecraft:particle_motion_parametric": {
        "relative_position": [
          "variable.fx * (variable.particle_random_2 * 4.5) + (variable.rx * Math.cos((variable.particle_random_1 * 360)) - variable.rz * variable.fy * Math.sin((variable.particle_random_1 * 360))) * (0.65 + variable.particle_random_3 * 0.5 + variable.particle_age * 1.5)",
          "variable.fy * (variable.particle_random_2 * 4.5) + (variable.rz * variable.fx - variable.rx * variable.fz) * Math.sin((variable.particle_random_1 * 360)) * (0.65 + variable.particle_random_3 * 0.5 + variable.particle_age * 1.5)",
          "variable.fz * (variable.particle_random_2 * 4.5) + (variable.rz * Math.cos((variable.particle_random_1 * 360)) + variable.rx * variable.fy * Math.sin((variable.particle_random_1 * 360))) * (0.65 + variable.particle_random_3 * 0.5 + variable.particle_age * 1.5)"
        ]
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "((variable.hot > 0 && variable.particle_random_4 < 0.45) ? 0.07 : 0.11 + variable.particle_random_3 * 0.08) * (1 - 0.5 * (variable.particle_age / variable.particle_lifetime))",
          "((variable.hot > 0 && variable.particle_random_4 < 0.45) ? 0.07 : 0.11 + variable.particle_random_3 * 0.08) * (1 - 0.5 * (variable.particle_age / variable.particle_lifetime))"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 32,
          "texture_height": 32,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            32,
            32
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "(variable.hot > 0 && variable.particle_random_4 < 0.45) ? 1 : 0.55",
          "(variable.hot > 0 && variable.particle_random_4 < 0.45) ? 0.92 - 0.6 * (variable.particle_age / variable.particle_lifetime) : 0.85",
          "(variable.hot > 0 && variable.particle_random_4 < 0.45) ? 0.5 - 0.4 * (variable.particle_age / variable.particle_lifetime) : 1",
          "1 - (variable.particle_age / variable.particle_lifetime)"
        ]
      }
    }
  }
}
