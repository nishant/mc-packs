{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "realm:sky_debris",
      "basic_render_parameters": {
        "material": "particles_alpha",
        "texture": "textures/particle/realm_sky_bits"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 5
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0
      },
      "minecraft:emitter_shape_disc": {
        "plane_normal": "y",
        "radius": "(variable.radius > 0 ? variable.radius : 2)",
        "direction": "outwards",
        "surface_only": true
      },
      "minecraft:particle_initial_speed": "Math.random(3, 7)",
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "Math.random(1.5, 2.5)"
      },
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          "variable.particle_age < 0.35 ? 22 : -14",
          0
        ],
        "linear_drag_coefficient": 0.6
      },
      "minecraft:particle_motion_collision": {
        "collision_radius": 0.08,
        "collision_drag": 6,
        "coefficient_of_restitution": 0.2
      },
      "minecraft:particle_initial_spin": {
        "rotation": "Math.random(0, 360)",
        "rotation_rate": "Math.random(-500, 500)"
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.1 + variable.particle_random_2 * 0.08",
          "0.1 + variable.particle_random_2 * 0.08"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 16,
          "texture_height": 8,
          "uv": [
            "variable.particle_random_3 < 0.5 ? 0 : 8",
            0
          ],
          "uv_size": [
            8,
            8
          ]
        }
      },
      "minecraft:particle_appearance_lighting": {},
      "minecraft:particle_appearance_tinting": {
        "color": [
          "variable.particle_random_3 < 0.5 ? 0.3 : 0.38",
          "variable.particle_random_3 < 0.5 ? 0.38 : 0.28",
          0.18,
          "Math.clamp(Math.min(variable.particle_age / 0.05, (variable.particle_lifetime - variable.particle_age) / 0.4), 0, 1)"
        ]
      }
    }
  }
}
