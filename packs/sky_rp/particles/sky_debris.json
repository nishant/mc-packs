{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "realm:sky_debris",
      "basic_render_parameters": {
        "material": "particles_alpha",
        "texture": "textures/particle/realm_sky_bits"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 12
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0
      },
      "minecraft:emitter_shape_point": {},
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "Math.random(1.2, 2.1)"
      },
      "minecraft:particle_motion_parametric": {
        "relative_position": [
          "Math.cos(variable.particle_random_1 * 360 + variable.particle_age * 380) * ((variable.radius > 0 ? variable.radius : 2.5) + variable.particle_age * (1.8 + variable.particle_random_2 * 2.4))",
          "variable.particle_age * (3.2 + variable.particle_random_3 * 3.5) - variable.particle_age * variable.particle_age * 1.1",
          "Math.sin(variable.particle_random_1 * 360 + variable.particle_age * 380) * ((variable.radius > 0 ? variable.radius : 2.5) + variable.particle_age * (1.8 + variable.particle_random_2 * 2.4))"
        ]
      },
      "minecraft:particle_initial_spin": {
        "rotation": "Math.random(0, 360)",
        "rotation_rate": "Math.random(-640, 640)"
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.15 + variable.particle_random_2 * 0.12",
          "0.15 + variable.particle_random_2 * 0.12"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 16,
          "texture_height": 8,
          "uv": [
            "variable.particle_random_3 < 0.5 ? 0 : 8",
            0
          ],
          "uv_size": [
            8,
            8
          ]
        }
      },
      "minecraft:particle_appearance_lighting": {},
      "minecraft:particle_appearance_tinting": {
        "color": [
          "variable.particle_random_3 < 0.5 ? 0.32 : 0.42",
          "variable.particle_random_3 < 0.5 ? 0.42 : 0.30",
          0.2,
          "Math.clamp(Math.min(variable.particle_age / 0.08, (variable.particle_lifetime - variable.particle_age) / 0.35), 0, 1)"
        ]
      }
    }
  }
}
