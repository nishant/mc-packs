{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "realm:sky_rainbow_beam",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particle/realm_sky_beam"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 1
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0
      },
      "minecraft:emitter_shape_point": {},
      "minecraft:particle_initial_speed": 0,
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "(variable.life > 0 ? variable.life : 2)"
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(variable.size > 0 ? variable.size : 0.5)",
          "(variable.height > 0 ? variable.height : 2)"
        ],
        "facing_camera_mode": "rotate_y",
        "uv": {
          "texture_width": 16,
          "texture_height": 32,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            16,
            32
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          1,
          1,
          1,
          "Math.clamp(Math.min(variable.particle_age / 0.3, (variable.particle_lifetime - variable.particle_age) / 0.5), 0, 1) * (variable.alpha > 0 ? variable.alpha : 1) * 0.9"
        ]
      }
    }
  }
}
