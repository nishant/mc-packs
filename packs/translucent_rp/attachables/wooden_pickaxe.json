{
  "format_version": "1.10.0",
  "minecraft:attachable": {
    "description": {
      "identifier": "minecraft:wooden_pickaxe",
      "materials": {
        "default": "entity_alphablend",
        "solid": "entity_alphatest",
        "solid_enchanted": "entity_alphatest_glint"
      },
      "textures": {
        "default": "textures/translucent_tools/wood_pickaxe",
        "solid": "textures/translucent_tools/shape/wood_pickaxe",
        "shape": "textures/translucent_tools/shape/wood_pickaxe",
        "enchanted": "textures/misc/enchanted_item_glint"
      },
      "geometry": {
        "default": "geometry.realm_translucent.tool"
      },
      "animations": {
        "first_person": "animation.realm_translucent.tool.first_person",
        "third_person": "animation.realm_translucent.tool.third_person",
        "first_person_off_hand": "animation.realm_translucent.tool.first_person_off_hand",
        "third_person_off_hand": "animation.realm_translucent.tool.third_person_off_hand"
      },
      "scripts": {
        "pre_animation": [
          "variable.realm_solid = query.has_property('realm:solid_tools') ? query.property('realm:solid_tools') : 0.0;",
          "variable.main_hand = c.item_slot == 'main_hand';",
          "variable.off_hand = c.item_slot == 'off_hand';"
        ],
        "animate": [
          {
            "first_person": "variable.main_hand && c.is_first_person"
          },
          {
            "third_person": "variable.main_hand && !c.is_first_person"
          },
          {
            "first_person_off_hand": "variable.off_hand && c.is_first_person"
          },
          {
            "third_person_off_hand": "variable.off_hand && !c.is_first_person"
          }
        ]
      },
      "render_controllers": [
        "controller.render.realm_translucent.item"
      ]
    }
  }
}
