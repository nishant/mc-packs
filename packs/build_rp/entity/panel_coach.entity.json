{"format_version":"1.10.0","minecraft:client_entity":{"description":{"identifier":"eb:panel_coach","materials":{"default":"entity_emissive_alpha","glass":"entity_alphablend","back":"entity"},"textures":{"default":"textures/entity/panels/coach","en":"textures/entity/panels/en/coach","es":"textures/entity/panels/es/coach","de":"textures/entity/panels/de/coach","pt":"textures/entity/panels/pt/coach","nl":"textures/entity/panels/nl/coach","id":"textures/entity/panels/id/coach","sq":"textures/entity/panels/sq/coach","ru":"textures/entity/panels/ru/coach","ja":"textures/entity/panels/ja/coach","ko":"textures/entity/panels/ko/coach","hi":"textures/entity/panels/hi/coach","te":"textures/entity/panels/te/coach","ur":"textures/entity/panels/ur/coach"},"geometry":{"default":"geometry.eb_panel_coach"},"animations":{"panel":"animation.eb_panel_coach.panel"},"scripts":{"pre_animation":["v.p_hover = q.property('eb:hover');","v.p_step = q.property('eb:step');","v.p_info = q.property('eb:info');","v.p_okn = q.property('eb:okn');","v.p_toastn = q.property('eb:toastn');","v.p_fin = q.property('eb:fin');","v.p_go = q.property('eb:go');","v.p_stuck = q.property('eb:stuck');","v.p_closing = q.property('eb:closing');","v.p_quiet = q.property('eb:quiet');","v.p_enter = q.property('eb:enter');","v.p_leave = q.property('eb:leave');","v.p_press = q.property('eb:press');","v.p_pressn = q.property('eb:pressn');","v.p_spot = q.property('eb:spot');","v.p_lang = q.property('eb:lang');","v.key = v.p_step * 2 + (v.p_stuck ? 1 : 0);","v.cs = v.cs ?? v.key;","v.cs_t = v.cs != v.key ? math.max(0, (v.cs_t ?? 1) - q.delta_time / 0.12) : math.min(1, (v.cs_t ?? 1) + q.delta_time / 0.12);","v.cs = v.cs_t <= 0 ? v.key : v.cs;","v.cs_e = v.cs_t * v.cs_t * (3 - 2 * v.cs_t);","v.cs_step = math.floor(v.cs / 2);","v.cs_same = math.floor(v.key / 2) == v.cs_step;","v.still = v.p_quiet || v.p_enter > 0;","v.open = v.still ? 1 : (1 + 2.70158 * math.pow(math.min(1, q.life_time / 0.4) - 1, 3) + 1.70158 * math.pow(math.min(1, q.life_time / 0.4) - 1, 2));","v.shut_t = math.clamp((v.shut_t ?? 0) + (v.p_closing ? 1 : -1) * q.delta_time / 0.25, 0, 1);","v.shut = v.shut_t * v.shut_t * (3 - 2 * v.shut_t);","v.ent = v.p_enter > 0 ? math.pow(1 - math.min(1, q.life_time / 0.3), 3) : 0;","v.leave_t = math.clamp((v.leave_t ?? 0) + (v.p_leave > 0 ? q.delta_time / 0.25 : 0), 0, 1);","v.leave_e = v.leave_t * v.leave_t;","v.slide = 17.082 * ((v.p_enter == 1 ? v.ent : (v.p_enter == 2 ? -v.ent : 0)) + (v.p_leave == 1 ? -v.leave_e : (v.p_leave == 2 ? v.leave_e : 0)));","v.pn = v.pn ?? v.p_pressn;","v.press_t = v.pn != v.p_pressn ? 0 : math.min(1, (v.press_t ?? 1) + q.delta_time / 0.3);","v.pn = v.p_pressn;","v.dip = math.sin(v.press_t * 180) * (1 - v.press_t) * 2;","v.ring = v.press_t < 1 ? 1 + 0.07 * (1 - math.pow(1 - v.press_t, 3)) : 0;","v.aim_1 = math.lerp(v.aim_1 ?? 0, v.p_hover == 1 ? 1 : 0, math.min(1, q.delta_time * 16));","v.in_1 = v.p_enter > 0 ? 1 : (v.p_quiet ? math.clamp((q.life_time - 0.014) / 0.2, 0, 1) : math.clamp((q.life_time - 0.094) / 0.3, 0, 1));","v.aim_2 = math.lerp(v.aim_2 ?? 0, v.p_hover == 2 ? 1 : 0, math.min(1, q.delta_time * 16));","v.in_2 = v.p_enter > 0 ? 1 : (v.p_quiet ? 1 : math.clamp((q.life_time - 0.108) / 0.3, 0, 1));","v.aim_3 = math.lerp(v.aim_3 ?? 0, v.p_hover == 3 ? 1 : 0, math.min(1, q.delta_time * 16));","v.in_3 = v.p_enter > 0 ? 1 : (v.p_quiet ? math.clamp((q.life_time - 0.028) / 0.2, 0, 1) : math.clamp((q.life_time - 0.122) / 0.3, 0, 1));","v.show_3 = math.lerp(v.show_3 ?? ((v.p_go) ? 1 : 0), (v.p_go) ? 1 : 0, math.min(1, q.delta_time * 18));","v.aim_4 = math.lerp(v.aim_4 ?? 0, v.p_hover == 4 ? 1 : 0, math.min(1, q.delta_time * 16));","v.in_4 = v.p_enter > 0 ? 1 : (v.p_quiet ? math.clamp((q.life_time - 0.042) / 0.2, 0, 1) : math.clamp((q.life_time - 0.136) / 0.3, 0, 1));","v.sn_0 = v.sn_0 ?? v.p_okn;","v.st_0 = v.sn_0 != v.p_okn ? 0 : math.min(1.9, (v.st_0 ?? 1.9) + q.delta_time);","v.sn_0 = v.p_okn;","v.sn_1 = v.sn_1 ?? v.p_toastn;","v.st_1 = v.sn_1 != v.p_toastn ? 0 : math.min(3.6, (v.st_1 ?? 3.6) + q.delta_time);","v.sn_1 = v.p_toastn;","v.sn_2 = v.sn_2 ?? v.p_toastn;","v.st_2 = v.sn_2 != v.p_toastn ? 0 : math.min(3.6, (v.st_2 ?? 3.6) + q.delta_time);","v.sn_2 = v.p_toastn;","v.cx = math.lerp(v.cx ?? q.property('eb:cx'), q.property('eb:cx'), math.min(1, q.delta_time * 28));","v.cy = math.lerp(v.cy ?? q.property('eb:cy'), q.property('eb:cy'), math.min(1, q.delta_time * 28));","v.cur = math.lerp(v.cur ?? 0, q.property('eb:aim') ? 1 : 0, math.min(1, q.delta_time * 16));","v.csx = math.max(0.004, v.cx / 330);","v.csy = math.max(0.004, v.cy / 164);"],"animate":["panel"]},"render_controllers":["controller.render.eb_panel_coach","controller.render.eb_panel_coach.text"],"enable_attachables":false}}}
