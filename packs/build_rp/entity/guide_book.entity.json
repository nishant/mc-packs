try":{"default":"geometry.eb_guide_book"},"animations":{"book":"animation.eb_guide_book.book","flip_sound":"animation.eb_guide_book.flip_sound","intro":"animation.eb_guide_book.intro","sounds":"controller.animation.eb_guide_book.sounds","arrival":"controller.animation.eb_guide_book.arrival"},"scripts":{"pre_animation":["v.target = q.property('eb:page');","v.first_page = q.property('eb:lang') * 48;","v.fresh = q.life_time < 0.3;","v.shown = v.fresh ? v.target : (v.shown ?? v.target);","v.to = v.fresh ? v.shown : (v.to ?? v.shown);","v.from = v.fresh ? v.shown : (v.from ?? v.shown);","v.flip_t = v.fresh ? 1 : (v.flip_t ?? 1);","v.starting = v.flip_t >= 1 && v.target != v.shown;","v.flip_time = v.starting ? (math.abs(v.target - v.shown) > 1 ? 0.13 : 0.42) : (v.flip_time ?? 0.42);","v.from = v.starting ? v.shown : v.from;","v.to = v.starting ? (v.target > v.shown ? v.shown + 1 : v.shown - 1) : v.to;","v.flip_t = v.starting ? 0 : math.min(1, v.flip_t + q.delta_time / v.flip_time);","v.shown = v.flip_t >= 1 ? v.to : v.shown;","v.forward = v.to > v.from;","v.flipping = v.flip_t < 1;","v.page_left = v.flipping ? (v.forward ? 2 * v.from : 2 * v.to) : 2 * v.shown;","v.page_right = v.flipping ? (v.forward ? 2 * v.to + 1 : 2 * v.from + 1) : 2 * v.shown + 1;","v.page_front = v.forward ? 2 * v.from + 1 : 2 * v.to + 1;","v.page_back = v.forward ? 2 * v.to : 2 * v.from;","v.ease = v.flip_t * v.flip_t * (3 - 2 * v.flip_t);","v.flip_angle = v.forward ? 12 + 156 * v.ease : 168 - 156 * v.ease;","v.arrive_t = math.clamp(q.life_time / 0.6, 0, 1);","v.arrive = 1 - math.pow(1 - v.arrive_t, 3);","v.grow = 1 + 2.70158 * math.pow(v.arrive_t - 1, 3) + 1.70158 * math.pow(v.arrive_t - 1, 2);","v.open_t = math.clamp((q.life_time - 0.5) / 0.55, 0, 1);","v.open_in = 1 + 2.70158 * math.pow(v.open_t - 1, 3) + 1.70158 * math.pow(v.open_t - 1, 2);","v.shut_t = math.clamp((v.shut_t ?? 0) + (q.property('eb:closing') ? 1 : -1) * q.delta_time / 0.7, 0, 1);","v.snap_t = math.clamp(v.shut_t / 0.4, 0, 1);","v.snap = v.snap_t * v.snap_t * (3 - 2 * v.snap_t);","v.leave_t = math.clamp((v.shut_t - 0.25) / 0.75, 0, 1);","v.leave = v.leave_t * v.leave_t;","v.shut = v.leave;","v.open = v.open_in * (1 - v.snap);","v.away = math.max(1 - v.arrive, v.leave);","v.riffle_t = (q.life_time - 0.85) / 0.45;","v.riffle = v.riffle_t > 0 && v.riffle_t < 1 && v.shut_t <= 0 && !v.flipping;","v.flip_angle = v.riffle ? 12 + 156 * math.mod(v.riffle_t * 2, 1) : v.flip_angle;"],"animate":["book","sounds","arrival"]},"sound_effects":{"page":"item.book.page_turn","open":"item.book.put"},"particle_effects":{"glint":"eb:book_glint"},"render_controllers":["controller.render.eb_guide_book.body","controller.render.eb_guide_book.left","controller.render.eb_guide_book.right","controller.render.eb_guide_book.front","controller.render.eb_guide_book.back","controller.render.eb_guide_book.left_ink","controller.render.eb_guide_book.right_ink","controller.render.eb_guide_book.front_ink","controller.render.eb_guide_book.back_ink"],"enable_attachables":false}}}
