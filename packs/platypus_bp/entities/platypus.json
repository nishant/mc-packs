{
  "format_version": "1.21.0",
  "minecraft:entity": {
    "description": {
      "identifier": "realm:platypus",
      "is_spawnable": true,
      "is_summonable": true,
      "is_experimental": false
    },
    "component_groups": {
      "realm:platypus_brown": {
        "minecraft:variant": { "value": 0 }
      },
      "realm:platypus_perry": {
        "minecraft:variant": { "value": 1 }
      },
      "realm:platypus_angry": {
        "minecraft:angry": {
          "duration": 15,
          "broadcast_anger": false,
          "calm_event": { "event": "realm:platypus_calm", "target": "self" }
        },
        "minecraft:timer": {
          "looping": false,
          "time": 15,
          "randomInterval": false,
          "time_down_event": { "event": "realm:platypus_calm", "target": "self" }
        },
        "minecraft:behavior.melee_attack": {
          "priority": 2,
          "speed_multiplier": 1.4,
          "track_target": true,
          "reach_multiplier": 1.5
        }
      }
    },
    "components": {
      "minecraft:type_family": { "family": ["platypus", "animal", "mob"] },
      "minecraft:collision_box": { "width": 0.6, "height": 0.45 },
      "minecraft:health": { "value": 10, "max": 10 },
      "minecraft:attack": { "damage": 2, "effect_name": "poison", "effect_duration": 5 },
      "minecraft:experience_reward": { "on_death": "query.last_hit_by_player ? math.random(1, 3) : 0" },
      "minecraft:nameable": {},
      "minecraft:leashable": { "soft_distance": 4.0, "hard_distance": 6.0, "max_distance": 10.0 },
      "minecraft:physics": {},
      "minecraft:pushable": { "is_pushable": true, "is_pushable_by_piston": true },
      "minecraft:jump.static": {},
      "minecraft:movement": { "value": 0.2 },
      "minecraft:movement.amphibious": { "max_turn": 15.0 },
      "minecraft:underwater_movement": { "value": 0.12 },
      "minecraft:water_movement": { "drag_factor": 0.9 },
      "minecraft:navigation.generic": {
        "is_amphibious": true,
        "can_path_over_water": false,
        "can_swim": true,
        "can_walk": true,
        "can_sink": false,
        "avoid_damage_blocks": true
      },
      "minecraft:breathable": {
        "breathes_air": true,
        "breathes_water": true,
        "suffocate_time": 0,
        "total_supply": 15,
        "generates_bubbles": false
      },
      "minecraft:hurt_on_condition": {
        "damage_conditions": [
          { "cause": "lava", "damage_per_tick": 4, "filters": { "test": "in_lava", "subject": "self", "operator": "==", "value": true } }
        ]
      },
      "minecraft:damage_sensor": {
        "triggers": [
          {
            "on_damage": {
              "filters": {
                "any_of": [
                  { "test": "is_family", "subject": "other", "value": "player" },
                  { "test": "is_family", "subject": "other", "value": "mob" }
                ]
              },
              "event": "realm:platypus_anger"
            },
            "deals_damage": "yes"
          }
        ]
      },
      "minecraft:behavior.hurt_by_target": { "priority": 1 },
      "minecraft:behavior.tempt": { "priority": 4, "speed_multiplier": 1.1, "items": ["minecraft:cod", "minecraft:salmon"] },
      "minecraft:behavior.random_swim": { "priority": 6, "speed_multiplier": 1.0, "interval": 80, "xz_dist": 10, "y_dist": 4 },
      "minecraft:behavior.random_stroll": { "priority": 6, "speed_multiplier": 1.0, "interval": 100 },
      "minecraft:behavior.move_to_water": { "priority": 7, "search_range": 12, "search_height": 4, "search_count": 1, "goal_radius": 1.5 },
      "minecraft:behavior.look_at_player": { "priority": 8, "look_distance": 6.0, "probability": 0.02 },
      "minecraft:behavior.random_look_around": { "priority": 9 }
    },
    "events": {
      "minecraft:entity_spawned": {
        "randomize": [
          { "weight": 199, "add": { "component_groups": ["realm:platypus_brown"] } },
          { "weight": 1, "add": { "component_groups": ["realm:platypus_perry"] } }
        ]
      },
      "realm:platypus_make_brown": {
        "add": { "component_groups": ["realm:platypus_brown"] },
        "remove": { "component_groups": ["realm:platypus_perry"] }
      },
      "realm:platypus_make_perry": {
        "add": { "component_groups": ["realm:platypus_perry"] },
        "remove": { "component_groups": ["realm:platypus_brown"] }
      },
      "realm:platypus_anger": {
        "sequence": [
          { "remove": { "component_groups": ["realm:platypus_angry"] } },
          { "add": { "component_groups": ["realm:platypus_angry"] } }
        ]
      },
      "realm:platypus_calm": {
        "remove": { "component_groups": ["realm:platypus_angry"] }
      }
    }
  }
}
