{
  "name": "mc-packs",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "node tools/check.mjs",
    "build": "node tools/build.mjs",
    "bundle": "node tools/bundle.mjs",
    "gen:rain": "node tools/gen-rain/textures.mjs && node tools/gen-rain/fogs.mjs && node tools/gen-rain/sounds.mjs",
    "gen:sky": "node tools/gen-sky/gen.mjs",
    "gen:translucent": "node tools/gen-translucent/generate.mjs",
    "gen:platypus": "node tools/gen-platypus/gen.mjs",
    "gen:build": "node tools/gen-build/gen.mjs",
    "gen:silly": "node tools/gen-silly/gen.mjs",
    "gen:glyphs": "node tools/gen-glyphs/gen.mjs",
    "lint": "eslint .",
    "test": "node --test --test-reporter=dot \"tools/**/*.test.mjs\""
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@minecraft/server": "2.1.0",
    "@minecraft/server-ui": "2.0.0",
    "@minecraft/vanilla-data": "1.26.52",
    "@nish/ui": "npm:nish-ui@3.2.0",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "typescript": "^5.9.0"
  },
  "overrides": {
    "minimatch": "^11.0.4"
  }
}
